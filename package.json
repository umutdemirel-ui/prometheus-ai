{
  "name": "prometheus-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js && vitest run",
    "start": "node --env-file-if-exists=.env server/index.js",
    "desktop-helper": "node desktop-helper/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "vitest": "^5.0.5"
  }
}
