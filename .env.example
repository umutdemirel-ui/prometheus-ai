# Server-side only. Ollama runs on the same machine as the server.
OLLAMA_URL=http://127.0.0.1:11434
# Optional OpenAI-compatible provider; never expose the secret with VITE_ prefix.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Public Supabase project URL and anon/publishable key (not service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
PORT=3001

# Optional local desktop helper proxy. Keep disabled on shared/remote previews.
ENABLE_DESKTOP_HELPER=false
